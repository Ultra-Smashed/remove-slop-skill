     "de": ["\\bzusammenfassend (?:lässt sich (?:sagen|festhalten)|kann man sagen|gesagt)?\\b", "\\babschließend (?:lässt sich|kann man|bleibt)\\b", "(?m)^(?:#+\\s*)?(?:Fazit|Zusammenfassung)\\s*:?\\s*$", "(?m)^Fazit:", "\\bunterm Strich\\b", "\\bwie (?:wir|bereits|oben|eingangs) (?:gesehen|erwähnt|beschrieben|gezeigt)(?: haben)?\\b", "\\bwie bereits erwähnt\\b", "\\bin diesem (?:Abschnitt|Artikel|Beitrag|Kapitel) (?:werden wir|schauen wir|erfährst du|erfahren Sie|geht es um)\\b", "\\bim nächsten Abschnitt\\b", "\\blange Rede, kurzer Sinn\\b", "\\bauf den Punkt gebracht\\b", "\\bletztendlich zeigt sich\\b", "\\bdie Zukunft (?:bleibt|wird) spannend\\b", "\\bdie Zukunft sieht (?:rosig|vielversprechend|hell) aus\\b"],
