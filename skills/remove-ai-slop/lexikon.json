    {"nr": 32, "id": "meta-hinweis", "name": "Meta-Hinweis", "gruppe": "Rhetorik", "kurz": "„Es ist wichtig zu beachten, dass …“: sagt dem Leser, was er denken soll, bevor die Aussage kommt.",
     "de": ["\\bes ist (?:wichtig|entscheidend|erwähnenswert|bemerkenswert|wesentlich) (?:zu (?:beachten|betonen|erwähnen|verstehen|wissen|bedenken)|festzuhalten|hervorzuheben)\\b", "\\bes sei (?:darauf hingewiesen|angemerkt|betont|erwähnt)\\b", "\\ban dieser Stelle sei\\b", "\\bes lohnt sich, (?:hervorzuheben|zu erwähnen|zu betonen)\\b", "\\bes sollte (?:beachtet|betont|erwähnt|hervorgehoben) werden\\b", "\\bes ist kein Geheimnis, dass\\b", "\\bes lässt sich nicht leugnen\\b", "\\bwichtig (?:zu wissen|ist dabei|dabei ist)\\b"],
     "en": ["\\bit'?s (?:important|worth|crucial|essential) (?:to (?:note|remember|mention|understand|highlight)|noting|mentioning)\\b", "\\bit should be noted\\b", "\\bit is worth noting\\b", "\\bit'?s no secret that\\b", "\\bneedless to say\\b"]},

    {"nr": 33, "id": "lehrer-modus", "name": "Lehrer-Modus", "gruppe": "Rhetorik", "kurz": "„Schauen wir uns das genauer an“, „Lass uns das aufschlüsseln“, „Stell dir das wie … vor“: Leserführung statt Inhalt.",
     "de": ["\\b(?:schauen|sehen|werfen) wir (?:uns )?(?:einen (?:genaueren |kurzen )?Blick|das (?:genauer|näher)|uns an)\\b", "\\blass(?:t)? uns (?:das |einen Blick |gemeinsam )?(?:aufschlüsseln|anschauen|ansehen|eintauchen|genauer betrachten|werfen)\\b", "\\bbrechen wir (?:das|es) herunter\\b", "\\bstell (?:dir|euch) (?:das|es) (?:so |wie )\\b", "\\bman kann sich das (?:so )?vorstellen wie\\b", "\\bhier ist, was (?:du|Sie|ihr) wissen (?:musst|müssen|müsst)\\b", "\\bim Folgenden (?:werden wir|schauen wir|erfährst du|erfahren Sie)\\b", "\\bkurz gesagt\\b", "\\bmit anderen Worten\\b", "\\bvereinfacht gesagt\\b"],
     "en": ["\\blet'?s (?:break (?:this|it) down|unpack|dive (?:in|into)|take a (?:closer )?look|explore)\\b", "\\bthink of it (?:as|like)\\b", "\\bhere'?s what you need to know\\b", "\\bin other words\\b", "\\bsimply put\\b", "\\bput simply\\b"]},

    {"nr": 34, "id": "falsche-spannung", "name": "Falsche Spannung", "gruppe": "Rhetorik", "kurz": "„Und jetzt kommt's“, „Der Clou:“, „Hier wird es spannend“: Spannung behaupten statt erzeugen.",
     "de": ["\\bund jetzt kommt'?s\\b", "\\bder Clou\\b", "\\bhier wird(?:'s| es) (?:spannend|interessant)\\b", "\\bjetzt wird(?:'s| es) (?:spannend|interessant)\\b", "\\bdas Beste (?:daran|kommt)\\b", "\\baber (?:hier|da) ist der Haken\\b", "\\bder Haken an der Sache\\b", "\\bSpoiler(?: Alert)?:", "\\bund das ist der Punkt\\b", "\\bhier ist das Ding\\b", "\\bdie Wahrheit ist\\b", "\\bdie unbequeme Wahrheit\\b"],
     "en": ["\\bhere'?s the (?:kicker|thing|catch|twist|deal)\\b", "\\bhere'?s where it gets interesting\\b", "\\bbut here'?s the\\b", "\\bthe truth is\\b", "\\bspoiler(?: alert)?:", "\\bplot twist\\b"]},

    {"nr": 35, "id": "stell-dir-vor", "name": "„Stell dir vor“", "gruppe": "Rhetorik", "kurz": "„Stell dir eine Welt vor, in der …“: eine Einladung zum Träumen statt des Arguments.",
     "de": ["\\bstell(?:t|en Sie)? (?:dir|euch|sich) (?:mal )?(?:eine Welt|eine Zukunft|vor, (?:dass|du|wie|was))\\b", "\\bstell(?:t|en Sie)? (?:dir|euch|sich) (?:mal )?vor\\b", "\\bhast du dich (?:jemals|je|schon einmal|schon mal) gefragt\\b", "\\bhaben Sie sich (?:jemals|je|schon einmal) gefragt\\b"],
     "en": ["\\bimagine (?:a world|a future|if you|what would|that)\\b", "\\bhave you ever wondered\\b", "\\bpicture this\\b"]},

    {"nr": 36, "id": "vage-autoritaet", "name": "Vage Autorität", "gruppe": "Rhetorik", "kurz": "„Studien zeigen“, „Experten sind sich einig“: eine Quelle ohne Namen.",
     "de": ["\\b(?:Studien|Untersuchungen|Umfragen|Analysen|Forschungen?) (?:zeigen|belegen|beweisen|legen nahe|deuten darauf hin)\\b", "\\b(?:Experten|Fachleute|Kritiker|Beobachter|Analysten|Wissenschaftler|Forscher) (?:sind sich einig|sagen|warnen|betonen|argumentieren|meinen|gehen davon aus)\\b", "\\bviele (?:Experten|Fachleute|Menschen) (?:sagen|glauben|meinen|sind der Meinung)\\b", "\\b(?:manche|einige) (?:sagen|argumentieren|behaupten|meinen)\\b", "\\bes heißt, dass\\b", "\\bBranchen(?:berichte|kenner|experten) (?:zeigen|sagen|gehen davon aus)\\b", "\\bwie (?:Studien|Experten) zeigen\\b", "\\bman sagt\\b"],
     "en": ["\\b(?:studies|research|surveys|reports) (?:show|suggest|indicate|have shown)\\b", "\\b(?:experts|critics|observers|analysts|scientists|researchers) (?:agree|argue|say|note|warn|believe)\\b", "\\bmany (?:experts|people) (?:believe|say|argue)\\b", "\\bsome (?:argue|say|believe)\\b", "\\bit is (?:widely )?(?:believed|said|thought)\\b"]},

    {"nr": 37, "id": "trotz-herausforderungen", "name": "„Trotz aller Herausforderungen“", "gruppe": "Rhetorik", "kurz": "„Trotz einiger Herausforderungen …“: ein Zugeständnis, das nichts benennt.",
     "de": ["\\btrotz (?:aller|einiger|dieser|der|mancher|gewisser|bestehender|zahlreicher)? ?(?:Herausforderungen|Hürden|Schwierigkeiten|Einschränkungen|Hindernisse|Rückschläge)\\b", "\\bbei allen (?:Herausforderungen|Schwierigkeiten)\\b", "\\bnicht ohne (?:Herausforderungen|Schwierigkeiten|Hürden)\\b", "\\bbirgt (?:sowohl )?(?:Chancen als auch Risiken|Risiken und Chancen)\\b"],
     "en": ["\\bdespite (?:its|these|the|some|many|all)? ?(?:challenges|obstacles|limitations|setbacks|hurdles)\\b", "\\bnot without (?:its )?(?:challenges|flaws)\\b", "\\bboth opportunities and (?:challenges|risks)\\b"]},

    {"nr": 38, "id": "ausgewogenheits-reflex", "name": "Ausgewogenheits-Reflex", "gruppe": "Rhetorik", "kurz": "Jede Aussage wird sofort wieder relativiert: „Gleichzeitig darf man nicht vergessen …“.",
     "de": ["\\bgleichzeitig (?:darf|sollte) man (?:aber )?nicht (?:vergessen|übersehen|außer Acht lassen)\\b", "\\bandererseits\\b", "\\bauf der anderen Seite\\b", "\\bnatürlich gibt es auch\\b", "\\bman sollte (?:aber |jedoch )?(?:auch )?(?:bedenken|berücksichtigen)\\b", "\\bwie so oft liegt die Wahrheit\\b", "\\bes kommt (?:ganz )?darauf an\\b", "\\bhat (?:sowohl )?Vor- und Nachteile\\b"],
     "en": ["\\bon the other hand\\b", "\\bthat (?:said|being said)\\b", "\\bat the same time,? (?:it'?s|we must)\\b", "\\bthe truth (?:lies|is) somewhere in (?:the )?between\\b", "\\bit depends\\b", "\\bpros and cons\\b"]},

    {"nr": 39, "id": "gespielte-offenheit", "name": "Gespielte Offenheit", "gruppe": "Rhetorik", "kurz": "„Ehrlich gesagt“, „Seien wir ehrlich“, „Ich gebe zu“: Ehrlichkeit als Pose.",
     "de": ["\\behrlich gesagt\\b", "\\bseien wir (?:mal )?ehrlich\\b", "\\bganz ehrlich\\b", "\\bich (?:muss|will) (?:ehrlich sein|zugeben|gestehen)\\b", "\\bich gebe (?:es )?zu\\b", "\\bHand aufs Herz\\b", "\\bunter uns gesagt\\b", "\\bich verrate (?:dir|euch|Ihnen) (?:ein Geheimnis|etwas)\\b"],
     "en": ["\\bI'?ll be honest\\b", "\\blet'?s be (?:real|honest)\\b", "\\bto be honest\\b", "\\bhonestly,\\b", "\\bI(?:'ll| have to| must) admit\\b", "\\bfull disclosure\\b"]},

    {"nr": 40, "id": "anbiederung", "name": "Anbiederung und Empathie-Theater", "gruppe": "Rhetorik", "kurz": "„Gute Frage!“, „Ich verstehe, dass das schwierig sein kann“: Lob und Mitgefühl, das zu jedem Thema passt.",
     "de": ["\\b(?:Gute|Tolle|Super|Ausgezeichnete|Spannende|Hervorragende) Frage\\b", "\\bwas für eine (?:spannende|tolle|gute|interessante) (?:Frage|Idee|Überlegung)\\b", "\\bdu hast (?:völlig|absolut|vollkommen) recht\\b", "\\bSie haben (?:völlig|absolut|vollkommen) recht\\b", "\\bich verstehe (?:vollkommen|absolut|gut), dass\\b", "\\bdas (?:kann|muss) (?:sehr |wirklich )?(?:schwierig|frustrierend|belastend|überwältigend) sein\\b", "\\bdeine Gefühle sind (?:völlig )?(?:berechtigt|valide|nachvollziehbar)\\b", "\\bdu bist (?:damit )?nicht allein\\b"],
